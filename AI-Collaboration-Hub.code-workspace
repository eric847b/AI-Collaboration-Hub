{
  "folders": [
    {
      "path": "nexus-infinity-hub",
      "name": "nexus-infinity-hub"
    },
    {
      "path": "self-evolve-dash",
      "name": "self-evolve-dash"
    },
    {
      "path": "singularity-operator",
      "name": "singularity-operator"
    },
    {
      "path": "autonomous-github-agent",
      "name": "autonomous-github-agent"
    },
    {
      "path": "ai-chat-websites",
      "name": "ai-chat-websites"
    },
    {
      "path": "third-door-blink-controller",
      "name": "third-door-blink-controller"
    }
  ],
  "settings": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": true,
      "source.organizeImports": true
    },
    "editor.rulers": [80, 100, 120],
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "files.eol": "\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.exclude": {
      "**/.git": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/.venv": true,
      "**/node_modules": true,
      "**/coverage": true,
      "**/dist": true,
      "**/.turbo": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/coverage": true,
      "**/dist": true,
      "**/.venv": true,
      "**/.next": true
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll.eslint": true
      }
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll.eslint": true
      }
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[markdown]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.wordWrap": "on",
      "editor.rulers": [100]
    },
    "[python]": {
      "editor.defaultFormatter": "ms-python.python",
      "editor.formatOnSave": true,
      "editor.tabSize": 4,
      "editor.insertSpaces": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": true
      }
    },
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "python.linting.mypyEnabled": true,
    "python.formatting.provider": "black",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
      "tests"
    ],
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact"
    ],
    "eslint.run": "onSave",
    "eslint.autoFixOnSave": true,
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.locale": "en",
    "typescript.surveys.enabled": false,
    "git.ignoreLimitWarning": true,
    "git.autofetch": true,
    "git.autoStash": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.defaultProfile.osx": "zsh"
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.cpptools",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-vscode.makefile-tools",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "eamodio.gitlens",
      "GitHub.vscode-pull-request-github",
      "GitHub.copilot",
      "GitHub.copilot-chat",
      "EditorConfig.EditorConfig",
      "bradlc.vscode-tailwindcss",
      "firsttris.vscode-jest-runner",
      "vitest.explorer",
      "tamasfe.even-better-toml",
      "redhat.vscode-yaml",
      "DotJoshJohnson.xml",
      "ms-azuretools.vscode-docker",
      "ms-vscode-remote.remote-containers",
      "ms-vscode-remote.remote-ssh",
      "ms-vscode.remote-explorer",
      "rust-lang.rust-analyzer",
      "charliermarsh.ruff",
      "ms-python.black-formatter",
      "httpics.vscode-Thunder-Client",
      "ms-vscode-remote.vscode-remote-extensionpack"
    ]
  }
}
