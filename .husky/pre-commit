#!/bin/sh
# Fast path: skip entirely when nothing lintable is staged.
# (Invoking lint-staged with an empty staged set stalls >30s in this env.)
FILES=$(git diff --cached --name-only --diff-filter=ACMR || true)
# Lockfiles are machine-generated; prettier on multi-MB package-lock.json
# files stalls commits >30s. Exclude them unconditionally.
LINTABLE=$(echo "$FILES" | grep -E '\.(js|mjs|cjs|jsx|ts|tsx|json|md|css)$' | grep -vE '(^|/)(package-lock|npm-shrinkwrap)\.json$' || true)
if [ -z "$LINTABLE" ]; then
  exit 0
fi

# Dependency-free JS gate: ONE node process checks every staged JS file
# (zero node_modules required). In-hook eslint stalls >30s on large staged
# sets here — run `npm run lint` out-of-band instead. Space-safe: paths are
# piped one per line, never word-split through an unquoted for-loop.
printf '%s\n' "$LINTABLE" | grep -E '\.(js|mjs|cjs)$' | node .husky/js-gate.mjs || exit 1

# Fully dependency-free: no prettier/eslint/husky binaries are consulted.
# JSON/MD/CSS staged sets pass through untouched; run `npm run lint`
# out-of-band for deep linting on projects that still opt into it.

# Defensive re-stage (no-op today) so any future formatter keeps its
# fixes inside the same commit.
printf '%s\n' "$LINTABLE" | git add --pathspec-from-file=-