{
  "name": "vite-react-shadcn",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --open",
    "dev:host": "vite --host 0.0.0.0 --open",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix || true",
    "typecheck": "tsc --noEmit",
    "prepare": "node -e \"if(!process.env.CI&&process.env.HUSKY!=='0'){try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}}\"",
    "check": "npm run lint && npm run typecheck",
    "ci": "npm run check && npm run build",
    "test:e2e": "playwright test --grep-invert visual",
    "test:visual": "playwright test e2e/visual.spec.js",
    "e2e:slow": "set PLAYWRIGHT_TEST_TIMEOUT=600000 && playwright test --reporter=list"
  },
