# Expo Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

# Variables prefixed with EXPO_PUBLIC_ are exposed to the client bundle.
# Example: an API endpoint consumed at runtime
# EXPO_PUBLIC_API_URL=https://api.example.com

# Example: a feature flag
# EXPO_PUBLIC_ENABLE_GENERATOR_VFX=true

# Server-only secrets (never exposed to the client) should go in EAS Secrets:
#   eas secret:create --name DATABASE_URL --value "postgres://..." --type env-var
# Then reference them in app.json extra or via process.env at build time.