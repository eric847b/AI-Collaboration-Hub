# Secrets - NEVER commit
*.key
*.pem
*.secret
secrets/
.env
.env.*

# API Keys
openai-api-key.txt
api-keys/
*groq*
*gemini*

# Node
node_modules/
npm-debug.log*
# Lockfiles are committed for reproducible builds (important for CI)
# Root lockfiles ignored; subproject lockfiles kept
/package-lock.json
/pnpm-lock.yaml
/yarn.lock

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Build outputs
build/
dist/
*.tsbuildinfo

# IDE
.vscode/
.idea/
.windsurf/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temp
tmp/
temp/.git_disabled/

# Local machine data (never commit)
AppData/
Roaming/
# Husky internals (machine-generated); user hooks like .husky/pre-commit ARE tracked
.husky/_/
**/.git_disabled/

# Local AI-agent state dirs (never commit)
.claude/
.clinerules/
.renitor/

# Generated analysis reports (regenerated by tools/review-repos.ps1,
# tools/analyze-freedom.ps1) — never commit stale snapshots
FreedomReport.txt
LocalRepoReview.txt
