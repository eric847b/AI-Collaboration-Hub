{
  "name": "ai-chat-userscript-suite",
  "version": "2.1.2",
  "description": "Sovereign Singularity - Self-evolving autonomous agent suite for ai-chat-websites",
  "scripts": {
    "verify": "node ./Userscripts/tools/run-suite.cjs verify",
    "validate": "node ./Userscripts/tools/run-suite.cjs validate",
    "test": "node ./Userscripts/tools/run-suite.cjs test",
    "lint": "node ./Userscripts/tools/run-suite.cjs lint",
    "check": "node ./Userscripts/tools/run-suite.cjs verify:ci",
    "lint:js": "node ./Userscripts/tools/run-suite.cjs lint",
    "lint:md": "node ./Userscripts/tools/run-suite.cjs lint:md",
    "format": "node ./Userscripts/tools/run-suite.cjs format",
    "typecheck": "tsc --noEmit",
    "prepare": "node -e \"console.log('prepare skipped')\"",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "build": "node scripts/build-userscript.js",
    "build:watch": "node scripts/build-userscript.js --watch",
    "dev": "node scripts/build-userscript.js && npm run lint",
    "validate:modules": "node scripts/validate-modules.js",
    "check:deps": "node scripts/check-dependencies.js",
    "validate:root": "node scripts/validate.cjs",
    "security:audit:scripts": "node scripts/security-audit.cjs",
    "consolidate-duplicates": "node scripts/consolidate-all.cjs",
    "autonomous-check": "node scripts/autonomous-check.cjs",
    "test:modules": "npx jest --runInBand --testMatch \"**/tests/**/*.test.js\"",
    "test:coverage": "npx jest --runInBand --coverage --testMatch \"**/tests/**/*.test.js\""
  },
  "jest": {
    "rootDir": ".",
    "roots": ["<rootDir>/tests"],
    "setupFilesAfterEnv": [
      "<rootDir>/Userscripts/AI Chat Userscript Studio/Userscript Suite/scripts/jest-setup.js"
    ],
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "^../Userscripts/modules/(.*)$": "<rootDir>/Userscripts/modules/$1"
    },
    "collectCoverageFrom": [
      "Userscripts/modules/**/*.js",
      "!Userscripts/modules/**/*.test.js",
      "!Userscripts/modules/**/*.spec.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "main": "_check_state.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eric847b/ai-chat-websites.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/eric847b/ai-chat-websites/issues"
  },
  "homepage": "https://github.com/eric847b/ai-chat-websites#readme",
  "dependencies": {
    "@utcp/code-mode-mcp": "^1.2.1",
    "@vapi-ai/mcp-server": "^0.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.69.0",
    "babel-jest": "^30.4.1",
    "eslint": "^10.6.0",
    "ini": "^7.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "markdownlint-cli": "^0.49.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.0.3",
    "browserslist": ">=4.28.8",
    "@xmldom/xmldom": ">=0.9.10",
    "decode-uri-component": ">=0.4.1",
    "image-size": ">=2.0.0"
  }
}