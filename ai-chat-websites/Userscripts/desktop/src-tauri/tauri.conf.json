{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Assistant Suite",
  "version": "0.1.0",
  "identifier": "com.aisuite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Assistant Suite",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}