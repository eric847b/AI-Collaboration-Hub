{
  "$schema": "https://json.schemastore.org/package",
  "name": "ai-chat-userscript-suite",
  "version": "1.1.0",
  "description": "Enterprise-grade modular userscript suite for AI chat platforms with advanced features",
  "private": true,
  "type": "module",
  "main": "00-hub.user.js",
  "exports": {
    ".": "./00-hub.user.js",
    "./settings": "./settings-ui.js",
    "./modules/*": "./Modules/*"
  },
  "files": [
    "00-hub.user.js",
    "settings-ui.js",
    "Modules/",
    "scripts/",
    "dist/",
    "README.md",
    "CONTRIBUTING.md",
    "DEVELOPMENT.md"
  ],
  "scripts": {
    "validate": "node ./scripts/validate.cjs",
    "test": "npx jest --runInBand",
    "test:watch": "npx jest --watch",
    "test:coverage": "npx jest --coverage",
    "test:quick": "node ./scripts/quick-test.cjs",
    "test:ci": "npx jest --ci --coverage --runInBand",
    "test:unit": "npx jest --testPathPattern=unit",
    "test:integration": "npx jest --testPathPattern=integration",
    "test:e2e": "npx jest --testPathPattern=e2e",
    "ai-assist": "node ./scripts/ai-dev-assistant.cjs",
    "verify": "npm run validate && npm test -- --runInBand && npm run test:quick && npm run lint && npm run lint:md",
    "verify:ci": "npm run validate && npm run test:ci && npm run lint && npm run lint:md",
    "bundle": "node ./scripts/bundle.cjs",
    "bundle:merge": "node ./scripts/bundle-merge.cjs",
    "bundle:minify": "node ./scripts/bundle-minify.cjs",
    "bundle:analyze": "node ./scripts/bundle-analyze.cjs",
    "prebundle": "npm run validate",
    "prebundle:merge": "npm run validate",
    "lint": "eslint --ext .js .",
    "lint:md": "node ./scripts/lint-markdown.mjs",
    "lint:fix": "eslint --ext .js . --fix",
    "lint:staged": "lint-staged",
    "dev": "node ./scripts/dev-server.cjs",
    "dev:hot": "node ./scripts/dev-server.cjs --hot",
    "dev:debug": "node --inspect ./scripts/dev-server.cjs",
    "prepare": "node ./scripts/setup-husky.js",
    "build": "npm run bundle",
    "build:merge": "npm run bundle:merge",
    "build:production": "npm run clean && npm run build:merge && npm run bundle:minify",
    "build:all": "npm run build && npm run build:merge",
    "clean": "node ./scripts/clean.cjs dist node_modules coverage .eslintcache",
    "clean:dist": "node ./scripts/clean.cjs dist",
    "clean:coverage": "node ./scripts/clean.cjs coverage",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "format:staged": "prettier --write",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "security:check": "npm audit --audit-level=high",
    "docs": "jsdoc -c jsdoc.conf.json",
    "docs:serve": "jsdoc -c jsdoc.conf.json && serve out",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "analyze": "webpack-bundle-analyzer dist/stats.json",
    "size": "size-limit",
    "size:check": "size-limit --json",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:dry": "standard-version --dry-run",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "precommit": "lint-staged",
    "prepush": "npm run verify",
    "commit": "cz",
    "commit:retry": "cz --retry"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.0.0",
    "@jest/globals": "^29.7.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^20.11.0",
    "babel-jest": "^29.7.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-cli": "^4.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.0",
    "lint-staged": "^15.2.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.2.0",
    "size-limit": "^11.0.0",
    "standard-version": "^9.5.0",
    "terser": "^5.28.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-bundle-analyzer": "^4.10.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "@kudoai/chatgpt.js": "^3.3.5"
  },
  "peerDependencies": {
    "@kudoai/chatgpt.js": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@kudoai/chatgpt.js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "lint-staged": {
    "*.{js,json,md}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix",
      "jest --bail --findRelatedTests"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "inquirer": "8.2.7",
    "lodash": "4.18.1",
    "tmp": "0.2.5"
  },
  "size-limit": [
    {
      "path": "00-hub.user.js",
      "limit": "50 KB"
    },
    {
      "path": "settings-ui.js",
      "limit": "30 KB"
    }
  ],
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "<rootDir>/Modules/.*\\.user\\.test\\.js$"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/scripts/jest-setup.js"
    ],
    "collectCoverageFrom": [
      "Modules/**/*.js",
      "!Modules/**/*.test.js",
      "!Modules/**/*.spec.js",
      "!Modules/_archive/**",
      "!Modules/_scratch/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json-summary"
    ],
    "coverageDirectory": "coverage",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js",
      "**/*.spec.js",
      "<rootDir>/../../../tests/**/*.test.js"
    ],
    "verbose": true,
    "bail": false,
    "clearMocks": true,
    "restoreMocks": true
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2024": true,
      "greasemonkey": true,
      "jest": true,
      "node": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
      "no-console": ["warn", { "allow": ["warn", "error", "info", "debug"] }],
      "prefer-const": "error",
      "no-var": "error",
      "eqeqeq": ["error", "always"],
      "curly": ["error", "multi-line"],
      "no-throw-literal": "error",
      "no-param-reassign": "warn",
      "no-return-await": "error",
      "require-await": "error",
      "no-async-promise-executor": "error"
    },
    "globals": {
      "GM_getValue": "readonly",
      "GM_setValue": "readonly",
      "GM_registerMenuCommand": "readonly",
      "GM_notification": "readonly",
      "GM_addStyle": "readonly",
      "GM_xmlhttpRequest": "readonly",
      "GM_download": "readonly",
      "GM_info": "readonly",
      "GM_openInTab": "readonly",
      "GM_setClipboard": "readonly",
      "console": "readonly",
      "performance": "readonly",
      "setTimeout": "readonly",
      "setInterval": "readonly",
      "clearTimeout": "readonly",
      "clearInterval": "readonly",
      "Promise": "readonly",
      "Map": "readonly",
      "Set": "readonly",
      "WeakMap": "readonly",
      "WeakSet": "readonly",
      "Proxy": "readonly",
      "Reflect": "readonly",
      "Symbol": "readonly",
      "Array": "readonly",
      "Object": "readonly",
      "String": "readonly",
      "Number": "readonly",
      "Boolean": "readonly",
      "Date": "readonly",
      "RegExp": "readonly",
      "Error": "readonly",
      "TypeError": "readonly",
      "RangeError": "readonly",
      "SyntaxError": "readonly",
      "ReferenceError": "readonly",
      "URIError": "readonly",
      "EvalError": "readonly",
      "JSON": "readonly",
      "Math": "readonly",
      "Intl": "readonly",
      "URL": "readonly",
      "URLSearchParams": "readonly",
      "Blob": "readonly",
      "File": "readonly",
      "FileReader": "readonly",
      "FormData": "readonly",
      "Headers": "readonly",
      "Request": "readonly",
      "Response": "readonly",
      "fetch": "readonly",
      "XMLHttpRequest": "readonly",
      "AbortController": "readonly",
      "AbortSignal": "readonly",
      "Event": "readonly",
      "EventTarget": "readonly",
      "CustomEvent": "readonly",
      "MessageChannel": "readonly",
      "MessagePort": "readonly",
      "structuredClone": "readonly",
      "queueMicrotask": "readonly",
      "reportError": "readonly"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "proseWrap": "always"
  },
  "keywords": [
    "userscript",
    "chatgpt",
    "ai",
    "automation",
    "modular",
    "tampermonkey",
    "greasemonkey",
    "enterprise",
    "plugin-system",
    "event-driven"
  ],
  "author": {
    "name": "AI RMD",
    "email": "ai-rmd@example.com",
    "url": "https://github.com/ai-rmd"
  },
  "contributors": [
    {
      "name": "AI RMD Contributors",
      "url": "https://github.com/ai-rmd/userscript-suite/graphs/contributors"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-rmd/userscript-suite.git",
    "directory": "Userscript Suite"
  },
  "bugs": {
    "url": "https://github.com/ai-rmd/userscript-suite/issues"
  },
  "homepage": "https://github.com/ai-rmd/userscript-suite#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ai-rmd"
  }
}
