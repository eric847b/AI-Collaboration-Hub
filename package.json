{
  "name": "workspace-root",
  "private": true,
  "description": "Multi-project AI collaboration workspace",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "bootstrap": "powershell -ExecutionPolicy Bypass -File ./tools/bootstrap.ps1",
    "gate": "powershell -ExecutionPolicy Bypass -File ./tools/workspace-gate.ps1",
    "verify": "npm run gate",
    "health": "npm run gate",
    "quality": "powershell -ExecutionPolicy Bypass -File ./tools/run-quality.ps1",
    "ai": "node collabhub-modules/run-ai.js",
    "lint": "echo 'Use: npm run lint:fix to auto-fix all projects (requires PowerShell)'",
    "ci": "npm run gate",
    "docs:check": "node tools/check-doc-links.mjs",
    "docs:links:check": "node tools/check-doc-links.mjs --check",
    "docs:links:update-baseline": "node tools/check-doc-links.mjs --update-baseline",
    "docs:json": "node tools/check-json-validity.mjs",
    "docs:json:check": "node tools/check-json-validity.mjs --check",
    "docs:json:update-baseline": "node tools/check-json-validity.mjs --update-baseline",
    "docs:scripts": "node tools/check-npm-scripts.mjs",
    "docs:scripts:check": "node tools/check-npm-scripts.mjs --check",
    "docs:scripts:update-baseline": "node tools/check-npm-scripts.mjs --update-baseline",
    "docs:facts": "node tools/check-doc-facts.mjs",
    "parity": "node tools/sync-parity.mjs check",
    "bloat:collect": "node tools/repo-bloat.mjs collect",
    "bloat:check": "node tools/repo-bloat.mjs check",
    "bloat:report": "node tools/repo-bloat.mjs report",
    "bloat:markdown": "node tools/repo-bloat.mjs markdown",
    "bloat:selftest": "node tools/repo-bloat.mjs --self-test",
    "metrics:report": "node tools/bundle-trend.cjs markdown",
    "dashboard": "node tools/ops-dashboard.mjs",
    "tools:verify": "node tools/verify-tools.mjs",
    "tools:verify:strict": "node tools/verify-tools.mjs --strict",
    "tools:verify:json": "node tools/verify-tools.mjs --json",
    "tools:verify:cli": "node tools/verify-tools.mjs --check-cli",
    "tools:flags": "node tools/check-flag-contract.mjs",
    "tools:flags:deep": "node tools/check-flag-contract.mjs --deep",
    "scaffold": "node tools/new-project.mjs --help",
    "scan:secrets": "node tools/secret-scan.mjs",
    "scan:staged": "node tools/secret-scan.mjs --staged",
    "workflow:audit": "node tools/workflow-audit.mjs",
    "workflow:audit:strict": "node tools/workflow-audit.mjs --strict --check-baseline",
    "check:handoff": "node tools/handoff-check.mjs",
    "health:fast": "node tools/quick-health.mjs",
    "health:fast:strict": "node tools/quick-health.mjs --strict",
    "health:fast:selftest": "node tools/quick-health.mjs --self-test",
    "autopilot:start": "powershell -ExecutionPolicy Bypass -File ./tools/manage-cline-autopilot.ps1 start",
    "autopilot:stop": "powershell -ExecutionPolicy Bypass -File ./tools/manage-cline-autopilot.ps1 stop",
    "autopilot:status": "powershell -ExecutionPolicy Bypass -File ./tools/manage-cline-autopilot.ps1 status",
    "autopilot:install": "powershell -ExecutionPolicy Bypass -File ./tools/manage-cline-autopilot.ps1 install",
    "autopilot:install-all": "powershell -ExecutionPolicy Bypass -File ./tools/manage-cline-autopilot.ps1 install-all",
    "autopilot:queue": "node tools/cline-prompt-queue.mjs",
    "telemetry:export": "node tools/telemetry-export.mjs serve",
    "autopilot:selftest": "powershell -ExecutionPolicy Bypass -File ./tools/cline-autopilot.ps1 -SelfTest",
    "autopilot:watchdog": "powershell -ExecutionPolicy Bypass -File ./tools/cline-autopilot-watchdog.ps1",
    "autopilot:watchdog:selftest": "powershell -ExecutionPolicy Bypass -File ./tools/cline-autopilot-watchdog.ps1 -SelfTest",
    "security:alerts": "node tools/fix-security-alerts.cjs alerts",
    "security:alerts:fetch": "node tools/fix-security-alerts.cjs fetch",
    "security:alerts:patch": "node tools/fix-security-alerts.cjs patch",
    "security:alerts:selftest": "node tools/fix-security-alerts.cjs selftest",
    "autopilot:run-once": "powershell -ExecutionPolicy Bypass -File ./tools/cline-autopilot.ps1 -Once -MaxLoops 1",
    "telemetry:serve": "node tools/telemetry-collector.mjs serve",
    "telemetry:report": "node tools/telemetry-collector.mjs report",
    "telemetry:prune": "node tools/telemetry-collector.mjs prune --keep 5000 --dry-run",
    "telemetry:selftest": "node tools/telemetry-collector.mjs --self-test",
    "tools:selftest": "node tools/secret-scan.mjs --self-test && node tools/handoff-check.mjs --self-test && node tools/workflow-audit.mjs --self-test && node tools/verify-tools.mjs --self-test && node tools/verify-tools.mjs --check-cli --quiet && node tools/check-flag-contract.mjs --self-test && node tools/check-json-validity.mjs --self-test && node tools/check-npm-scripts.mjs --self-test && node tools/check-doc-links.mjs --self-test && node tools/check-doc-facts.mjs --self-test && node tools/telemetry-collector.mjs --self-test && node tools/telemetry-export.mjs --self-test && node tools/quick-health.mjs --self-test && node tools/repo-bloat.mjs --self-test",
    "prepare": "git config core.hooksPath .husky"
  },
  "version": "1.0.0",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eric847b/AI-Collaboration-Hub.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/eric847b/AI-Collaboration-Hub/issues"
  },
  "homepage": "https://github.com/eric847b/AI-Collaboration-Hub#readme",
  "devDependencies": {}
}
