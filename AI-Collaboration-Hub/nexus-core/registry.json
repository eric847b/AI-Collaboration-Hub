{
  "system": "nexus-core",
  "version": "2.9.1",
  "modules": [
    {"name": "autonomous-github-agent", "role": "execution", "entrypoint": "python -m agent", "deps": []},
    {"name": "singularity-operator", "role": "execution", "entrypoint": "python singularity_operator.py", "deps": []},
    {"name": "self-evolve-dash", "role": "execution", "entrypoint": "npm run dev", "deps": ["nexus-infinity-hub"]},
    {"name": "nexus-infinity-hub", "role": "ui", "entrypoint": "npm run dev", "deps": []},
    {"name": "collabhub-modules", "role": "automation", "entrypoint": "npx", "deps": []},
    {"name": "VectorFS", "role": "memory", "entrypoint": "./build/vectorfs", "deps": []},
    {"name": "AI-Collaboration-Hub", "role": "coordination", "entrypoint": "python nexus-core/orchestrator.py", "deps": ["*"]},
    {"name": "ai-chat-websites", "role": "ui", "entrypoint": "node Userscripts/tools/suite-cli.cjs health", "deps": []},
    {"name": "nexus-core", "role": "coordination", "entrypoint": "python nexus-core/orchestrator.py", "deps": ["*"]},
    {"name": "solutions-dynamics", "role": "execution", "entrypoint": "python runtime_failure_handler.py", "deps": []}
  ],
  "optional_modules": [
    {"name": "unified-core", "role": "governance", "note": "not vendored in monorepo root"},
    {"name": "modular-hub-modernization", "role": "automation", "note": "external peer repo"},
    {"name": "third-door-blink-controller", "role": "ui", "note": "external peer"},
    {"name": "third-door-system", "role": "automation", "note": "external peer"}
  ],
  "roles": {
    "coordination": ["AI-Collaboration-Hub", "nexus-core"],
    "execution": ["singularity-operator", "autonomous-github-agent", "self-evolve-dash", "solutions-dynamics"],
    "ui": ["ai-chat-websites", "nexus-infinity-hub"],
    "automation": ["collabhub-modules"],
    "memory": ["VectorFS"]
  },
  "rules": [
    "All execution flows MUST register here",
    "No cross-repo mutation without registry entry",
    "CI must fail if any required module is missing on disk",
    "optional_modules are peers — not enforced on disk",
    "Runtime fails are absorbed; never bomb the user"
  ]
}
