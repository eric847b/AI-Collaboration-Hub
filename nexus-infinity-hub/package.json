{
  "name": "nexus-infinity-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-evolving AI collaboration and userscript hub",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "build:analyze": "vite build && node scripts/report-bundle-size.mjs",
    "analyze": "node scripts/report-bundle-size.mjs",
    "buildDev": "vite build --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix || true",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "test:e2e": "playwright test --grep-invert visual",
    "test:visual": "playwright test e2e/visual.spec.js",
    "ci": "npm run check",
    "ai": "node ..\\collabhub-modules\\run-ai.js",
    "e2e:slow": "playwright test --workers=1 --timeout=600000 --global-timeout=1200000 --reporter=list"
  },
